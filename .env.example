# Is file ko copy karke .env.local banao aur real values bharo.
# .env.local git ma commit nahi hota (.gitignore ma ha).

# --- Cloudinary ---
# Dashboard -> "Cloud name". NEXT_PUBLIC_ isliye ke browser ma image URL banane ke liye chahiye (secret nahi ha)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Sirf tab chahiye jab server se upload karo (form ma image upload / signed upload). Kabhi NEXT_PUBLIC_ mat lagana.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- MongoDB ---
# Atlas -> Connect -> Drivers se milti ha. Database ka naam URL ke end ma likho.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/media-production-art?retryWrites=true&w=majority
